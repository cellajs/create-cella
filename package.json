{
  "name": "@cellajs/create-cella",
  "version": "0.3.8",
  "private": false,
  "license": "MIT",
  "description": "Cella is a TypeScript template to create web apps with sync and offline capabilities.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cellajs/create-cella"
  },
  "homepage": "https://cellajs.com",
  "author": "CellaJS <info@cellajs.com>",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "index.js",
    "README.md"
  ],
  "imports": {
    "#/*": "./src/*"
  },
  "bin": {
    "create-cella": "index.js"
  },
  "scripts": {
    "start": "tsx ./src/create-cella-cli.ts",
    "try": "tsx ./src/create-cella-cli.ts ../cella-try-app",
    "clean": "rimraf ./dist",
    "build": "tsup",
    "test-build": "pnpm run build && node index.js",
    "prepublishOnly": "pnpm run test:release",
    "check": "pnpm ts && pnpm biome check --write .",
    "ts": "tsgo --pretty",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:release": "pnpm run build && vitest run --config vitest.release.config.ts",
    "test:watch": "vitest",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^15.0.0",
    "ignore": "^7.0.6",
    "isomorphic-git": "^1.40.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.1.0",
    "@evilmartians/lefthook": "^2.1.10",
    "@types/node": "24.13.3",
    "@types/validate-npm-package-name": "^4.0.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.8.0",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "perf",
          "refactor",
          "revert",
          "docs",
          "chore",
          "build",
          "ci",
          "style",
          "test"
        ]
      ]
    }
  }
}
